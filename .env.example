# Postgres connection string.
# Neon: Dashboard -> Connect -> enable "Connection pooling" -> copy the string (host contains "-pooler").
# Local, no account needed: run `npm run db:local` in a second terminal and keep the line below.
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5433/postgres"

# Signs login sessions. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# First admin account. Created by `npm run db:setup` (which also runs on every build) if no admin exists yet.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Public URL of the site, used for the sitemap and social previews (no trailing slash).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional - online payments through Razorpay. Leave empty to offer cash on delivery only.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
