# Postgres connection string.
# Neon: Dashboard -> Connect -> enable "Connection pooling" -> copy the string (host contains "-pooler").
# Local, no account needed: run `npm run db:local` in a second terminal and keep the line below.
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5433/postgres"

# Signs login sessions. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# First admin account. Created by `npm run db:setup` (which also runs on every build) if no admin exists yet.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Public URL of the site, used for the sitemap and social previews (no trailing slash).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional - online payments through Razorpay. Leave empty to offer cash on delivery only.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional - emails to customers (order confirmation, shipping updates, password reset),
# sent over SMTP. Works with Gmail or Google
# Workspace, Zoho, Brevo, Resend, Amazon SES and most other mail services.
# Gmail example: SMTP_HOST="smtp.gmail.com", SMTP_PORT="465", SMTP_USER="you@gmail.com",
# SMTP_PASS="<a Google app password>" (not your normal Gmail password).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# The address customers see the email from. Defaults to SMTP_USER.
# Example: "Aurelle <orders@yourbrand.com>"
EMAIL_FROM=""

# Optional - order confirmation text messages (SMS). Fill in ONE provider.
# Fast2SMS, for Indian mobile numbers:
FAST2SMS_API_KEY=""
# Twilio, for any country. TWILIO_FROM is your Twilio number or a Messaging Service id (MG...).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# Country code added to phone numbers that customers type without one.
SMS_COUNTRY_CODE="91"

# Local development only (ignored in production): instead of sending, write each
# email and text message to the .data/outbox folder so you can open and read them.
NOTIFICATIONS_PREVIEW="true"
